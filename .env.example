# Copy this file to .env and fill in your values
# Never commit .env to version control

# OpenAI API Key (required for full mode)
OPENAI_API_KEY=your_openai_api_key_here

# Set to "true" to run without API keys (for local testing)
USE_MOCK=false

# Hallucination probability threshold for flagging (0.0 - 1.0)
FLAG_THRESHOLD=0.45

# Server port
PORT=8000
